# Neon Postgres — the planner's database (Drizzle: src/lib/db/**).
# Pooled connection string from the Neon dashboard. Server-side only.
# Also gates src/lib/db/schema.integration.test.ts: unset = those tests skip.
DATABASE_URL=

# Old REST backend consumed by src/lib/api/**. It is gone; every call through
# that seam fails. Left here because the seam is still wired to ~40 call sites.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Maps — required by /home, /collections/**, /itineraries/**
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_LIGHT=

# Server-side Places API (New) key — used by scripts/ and the planner's
# server-side retrieval. Must NOT be HTTP-referrer restricted (that's the
# browser key above); restrict it by API instead. Needs "Places API (New)".
GOOGLE_PLACES_API_KEY=

# OpenAI — Pass B assignment (gpt-5.6-terra), Pass C narration and Stage 7
# enrichment (gpt-5.6-luna). Server-side only; never expose as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Photo blob store (S3-compatible: Cloudflare R2, Neon Object Storage, S3, MinIO).
# OPTIONAL — leave blank and the planner stores Google's photoUri, which is free
# to serve but expires, so a saved itinerary eventually shows broken images.
# Set ALL FOUR or none; a half-set config throws rather than silently falling
# back to the expensive path. The bucket must be publicly readable — this store
# issues no signed URLs.
PHOTO_BLOB_BUCKET=
PHOTO_BLOB_PUBLIC_URL=
PHOTO_BLOB_ACCESS_KEY_ID=
PHOTO_BLOB_SECRET_ACCESS_KEY=
# Region defaults to "auto" (what R2 and Neon want); endpoint is required for
# anything that isn't AWS S3 proper.
PHOTO_BLOB_REGION=
PHOTO_BLOB_ENDPOINT=

ATLAS_SANDBOX_ACCESS_KEY=
ATLAS_SANDBOX_SECRET_KEY=
