# Supabase — the new database plugs in here
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REST backend consumed by src/lib/api/** (Supabase JWT is sent as bearer)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Maps — required by /home, /collections/**, /itineraries/**
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_LIGHT=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_DARK=
