{
  "name": "argo-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "places:sample": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-singapore-place-details.ts",
    "personas:reach": "node --import ./scripts/lib/resolve-hooks.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/persona-reachability.ts",
    "personas:plan": "node --import ./scripts/lib/resolve-hooks.mjs --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/plan-persona-trips.ts",
    "personas:report": "node --import ./scripts/lib/resolve-hooks.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/persona-trips-report.ts",
    "enrichment:collect": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/collect-enrichment-batches.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio",
    "test:db": "node --env-file-if-exists=.env.local ./node_modules/.bin/vitest run -c vitest.integration.config.ts src/lib/db",
    "test:blobs": "node --env-file-if-exists=.env.local ./node_modules/.bin/vitest run -c vitest.integration.config.ts src/lib/planner/photo-blobs",
    "test:places": "node --env-file-if-exists=.env.local ./node_modules/.bin/vitest run -c vitest.integration.config.ts src/lib/planner/retrieval.integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.99.2",
    "@vis.gl/react-google-maps": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hashvatar": "^0.1.2",
    "lucide-react": "^0.576.0",
    "motion": "^12.34.4",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "openai": "^7.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/tz-lookup": "^6.1.2",
    "@vitest/ui": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
